generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id        Int    @id @default(autoincrement())
  name      String
  email     String @unique
  password  String
  birthDate String @map("birth_date")

  addresses Address[]
}

model Address {
  id           Int    @id @default(autoincrement())
  cep          String
  street       String
  streetNumber String @map("street_number")
  complement   String?
  neighborhood String
  city         String
  state        String

  user         User   @relation(fields: [userId], references: [id])
  userId       Int    @map("user_id")
}
