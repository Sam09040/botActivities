{
    "compilerOptions": {
        "experimentalDecorators": true,
        "emitDecoratorMetadata": true,
        "strictPropertyInitialization": false,
        "strictNullChecks": false,
        "allowJs": true,
        "maxNodeModuleJsDepth": 10,
        "rootDirs": ["src"],
        "outDir": "dist",
        "lib": ["ES2022", "ESNext.AsyncIterable"],
        "target": "ES2022",
        "module": "CommonJS",
        "strict": true,
        "useUnknownInCatchVariables": false,
        "esModuleInterop": true,
        "forceConsistentCasingInFileNames": true,
        "skipLibCheck": true,
        "resolveJsonModule": true,
        "types": ["node", "mocha"],
        "baseUrl": ".",
        "paths": {
            "@core": [ "src/core" ],
            "@core/*": [ "src/core/*" ],
            "@data": [ "src/data" ],
            "@data/*": [ "src/data/*" ],
            "@domain": [ "src/domain" ],
            "@domain/*": [ "src/domain/*" ],
            "@graphql": [ "src/api/graphql" ],
            "@graphql/*": [ "src/api/graphql/*" ],
            "@test": [ "src/test" ],
            "@test/*": [ "src/test/*" ],
            "@env": [ "src/env" ],
            "@env/*": [ "src/env/*" ],
        },
    },
}
