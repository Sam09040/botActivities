{
    "compilerOptions": {
        "baseUrl": "./src",
        "target": "ES2022",
        "module": "commonjs",
        "lib": ["ES2022", "esnext.asynciterable"],
        "emitDecoratorMetadata": true,
        "experimentalDecorators": true,
        "removeComments": true,
        "preserveConstEnums": true,
        "strict": true,
        "strictPropertyInitialization": false,
        "noImplicitAny": false,
        "useUnknownInCatchVariables": false,
        "outDir": "dist",
        "esModuleInterop": true,
        "skipLibCheck": true,
        "sourceMap": true,
        "paths": {
            "@core": [ "./core" ],
            "@core/*": [ "./core/*" ],
            "@data": [ "./data" ],
            "@data/*": [ "./data/*" ],
            "@domain": [ "./domain" ],
            "@domain/*": [ "./domain/*" ],
            "@graphql": [ "./api/graphql" ],
            "@graphql/*": [ "./api/graphql/*" ],
            "@test": [ "./test" ],
            "@test/*": [ "./test/*" ],
            "@env": [ "./env" ],
            "@env/*": [ "./env/*" ]
        }
    }
}
