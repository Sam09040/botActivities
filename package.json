{
  "name": "botactivities",
  "version": "1.0.0",
  "description": "Project using Apollo Server and Prisma using TypeScript",
  "main": "index.js",
  "scripts": {
    "start": "node --import=tsimp/import src/index.ts",
    "dev": "tsx watch src/index.ts",
    "lint": "eslint --fix src/**/*.ts test/**/*.ts",
    "check": "prettier --write src/**/*.ts test/*.ts && npm run lint",
    "start_test": "npx dotenvx run --env-file=.env.test -- npm run start",
    "test": "npx dotenvx run --env-file=.env.test -- mocha --import=tsimp/import test/*.test.ts",
    "reset": "npx prisma db push --force-reset",
    "reset_test": "npx dotenvx run --env-file=.env.test -- npx prisma db push --force-reset",
    "testdb": "npx dotenvx run --env-file=.env.test --",
    "seeds": "node --import=tsimp/import snaplet/seed/seed.ts"
  },
  "keywords": [
    "apollo",
    "prisma",
    "ts"
  ],
  "prisma": {
    "schema": "src/data/db/schema.prisma"
  },
  "author": "Sam",
  "license": "ISC",
  "type": "module",
  "dependencies": {
    "@faker-js/faker": "9.2.0",
    "@prisma/client": "6.0.0",
    "apollo-server": "3.13.0",
    "date-fns": "4.1.0",
    "fs": "0.0.1-security",
    "graphql": "16.9.0"
  },
  "devDependencies": {
    "@apollo/client": "3.11.10",
    "@apollo/server": "4.11.2",
    "@dotenvx/dotenvx": "1.25.1",
    "@eslint/js": "9.15.0",
    "@snaplet/copycat": "5.1.0",
    "@snaplet/seed": "0.98.0",
    "@types/bcrypt": "5.0.2",
    "@types/chai": "5.0.1",
    "@types/jsonwebtoken": "9.0.7",
    "@types/mocha": "10.0.10",
    "@types/node": "22.10.0",
    "apollo-server": "3.13.0",
    "axios": "1.7.8",
    "bcrypt": "5.1.1",
    "chai": "5.1.2",
    "dotenv": "16.4.5",
    "eslint": "9.15.0",
    "eslint-config-prettier": "9.1.0",
    "eslint-plugin-prettier": "5.2.1",
    "globals": "15.12.0",
    "graphql": "16.9.0",
    "jsonwebtoken": "9.0.2",
    "mocha": "10.8.2",
    "prettier": "3.4.1",
    "prisma": "6.0.0",
    "ts-node": "10.9.2",
    "tsimp": "2.0.12",
    "tsx": "4.19.2",
    "typescript": "5.7.2",
    "typescript-eslint": "8.16.0"
  }
}
