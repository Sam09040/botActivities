{
  "name": "botactivities",
  "version": "1.0.0",
  "description": "Project using Apollo Server and Prisma using TypeScript",
  "main": "index.js",
  "scripts": {
    "check": "prettier -w src/**/*.ts && npm run lint",
    "compose:stop": "docker-compose stop",
    "compose:start": "docker-compose start",
    "lint": "eslint --fix src/**/*.ts",
    "reset": "npx prisma db push --force-reset",
    "reset:test": "npm run testdb -- npx prisma db push --force-reset",
    "seeds": "npm run reset && node -r ts-node/register -r tsconfig-paths/register src/data/db/seed/seed.ts --exit",
    "start": "node -r ts-node/register -r tsconfig-paths/register src/index.ts",
    "start:test": "npm run testdb -- npm run start",
    "test": "npm run reset:test && jest",
    "testdb": "npx dotenvx run --env-file=.env.test --"
  },
  "keywords": [
    "apollo",
    "prisma",
    "typescript",
    "graphql"
  ],
  "prisma": {
    "schema": "src/data/db/schema.prisma",
    "seed": "src/data/db/seed.ts"
  },
  "author": "Sam",
  "license": "ISC",
  "type": "commonjs",
  "dependencies": {
    "@faker-js/faker": "9.2.0",
    "@jest/globals": "29.7.0",
    "@prisma/client": "6.0.0",
    "@types/jest": "29.5.14",
    "@types/mocha": "10.0.7",
    "@typescript-eslint/parser": "8.18.0",
    "apollo-server": "3.13.0",
    "chai": "4.4.1",
    "class-validator": "0.14.1",
    "csv-parser": "3.0.0",
    "date-fns": "4.1.0",
    "form-data": "4.0.1",
    "fs": "0.0.1-security",
    "graphql": "16.9.0",
    "graphql-scalars": "1.24.0",
    "graphql-upload-ts": "2.1.2",
    "jest": "29.7.0",
    "joi": "17.13.3",
    "mocha": "10.7.3",
    "reflect-metadata": "0.2.2",
    "resend": "4.0.1",
    "rimraf": "6.0.1",
    "ts-jest": "29.2.5",
    "tsconfig-paths": "4.2.0",
    "type-graphql": "2.0.0-rc.2",
    "typedi": "0.10.0"
  },
  "devDependencies": {
    "@apollo/client": "3.11.10",
    "@apollo/server": "4.11.2",
    "@dotenvx/dotenvx": "1.25.1",
    "@eslint/js": "9.15.0",
    "@types/bcrypt": "5.0.2",
    "@types/chai": "5.0.1",
    "@types/jsonwebtoken": "9.0.7",
    "@types/node": "22.10.0",
    "apollo-server": "3.13.0",
    "axios": "1.7.8",
    "bcrypt": "5.1.1",
    "dotenv": "16.4.5",
    "eslint": "9.15.0",
    "eslint-config-prettier": "9.1.0",
    "eslint-plugin-prettier": "5.2.1",
    "globals": "15.12.0",
    "graphql": "16.9.0",
    "jsonwebtoken": "9.0.2",
    "prettier": "3.4.1",
    "prisma": "6.0.0",
    "ts-node": "10.9.2",
    "tsx": "4.19.2",
    "typescript": "5.5.3",
    "typescript-eslint": "8.16.0"
  }
}
